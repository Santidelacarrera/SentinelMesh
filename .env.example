# Copy to .env (never commit .env). Every value below is a PLACEHOLDER: generate real ones.
NODE_ENV=production
INFRA_MODE=aws                          # production refuses simulated ports
DATABASE_URL=postgres://sentinel_app:CHANGE_ME@postgres:5432/sentinelmesh
DATABASE_ADMIN_URL=postgres://postgres:CHANGE_ME@postgres:5432/sentinelmesh   # only for `npm run db:migrate`
REDIS_URL=redis://redis:6379
OBJECT_STORE_BUCKET=sentinel-evidence
# 32 random bytes, base64: openssl rand -base64 32   (encrypts MFA seeds, connector credentials, webhooks)
SECRETS_ENCRYPTION_KEY=
SECRETS_ENCRYPTION_KEY_PREVIOUS=        # comma-separated old keys while rotating
# Approval signing: pick ONE of KMS / Ed25519 / HMAC
APPROVAL_KMS_KEY_ID=
APPROVAL_ED25519_PRIVATE_KEY=
APPROVAL_SIGNING_KEY=
# First platform administrator (created only if the platform organisation has no users)
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
AUTH_ALLOW_API_KEYS=0                   # disable static API keys once sessions/OIDC are in use
METRICS_TOKEN=                          # bearer token for /metrics
CORS_ORIGINS=                           # empty = closed (console is same-origin)
SMTP_URL=                               # smtps://user:pass@host:465
SMTP_FROM=sentinelmesh@example.com
DEFAULT_PLAN=enterprise                 # plan for orgs without a profile (self-hosted)
# Optional external AI (off unless an administrator also consents per organisation)
AI_LLM_URL=
AI_LLM_KEY=
